# Supabase — get from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin password — choose anything you want
ADMIN_PASSWORD=your-secret-password

# Email via Resend (free tier: 3,000 emails/month)
# Sign up at resend.com, verify your domain, get API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxx
EMAIL_FROM=chores@yourdomain.com

# SMS via Twilio (optional — comment out if using email only)
# Sign up at twilio.com, get a phone number (~$1/month)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15555555555

# Daughter names and contact info
DAUGHTER_1_NAME=Emma
DAUGHTER_1_EMAIL=emma@example.com
DAUGHTER_1_PHONE=+15555550001

DAUGHTER_2_NAME=Olivia
DAUGHTER_2_EMAIL=olivia@example.com
DAUGHTER_2_PHONE=+15555550002

# Cron job secret — prevents unauthorized triggering
CRON_SECRET=make-this-a-long-random-string

# Notification time (24hr, e.g. 07 = 7am) — set in vercel.json cron
# This is just for reference
NOTIFY_HOUR=7
